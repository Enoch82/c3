      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"hr-ia-webapp\" && span.session.trace.id = \"${session_trace_id}\" }",
          "limit": 100,
          "refId": "A"
        }
      ]
    },
