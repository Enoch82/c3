      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 74 },
      "id": 6,
      "title": "User journey (navegacion + auth)",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{exporter=\"OTLP\"} |= `${session_trace_id}` | json | log_service =~ `sidebar|header|login-page|campaigns-page|campaign-detail|review-queue|candidate-review|new-campaign|session|auth`",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 84 },
      "id": 305,
      "title": "Conversacion de un candidato (Telegram + OpenAI)",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 85 },
      "id": 60,
      "options": {
        "content": "### Entrevistas por Telegram\n- **Conversation ID**: obtenelo del log `Conversation created` (servicio `telegram`) o de cualquier log de `conversation`/`evaluation`. Filtra las trazas y el transcript completo de esa entrevista.\n- El panel de trazas muestra cada llamada real al LLM (`llm.conversation`, `llm.evaluation`) de esa conversacion — modelo, tokens, latencia.\n- El panel de logs reconstruye el transcript: mensaje del candidato -> fase -> respuesta del agente, mas eventos de consentimiento, escalacion y evaluacion.",
        "mode": "markdown"
      },
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 88 },
      "id": 7,
      "title": "Llamadas al LLM de la conversacion: $conversation_id",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"hr-ia-webapp\" && span.conversation.id = \"${conversation_id}\" }",
          "limit": 100,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 102 },
      "id": 8,
      "title": "Transcript de la conversacion: $conversation_id",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{exporter=\"OTLP\"} |= `${conversation_id}` | json | log_service =~ `telegram|conversation|openai|evaluation`",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 116 },
      "id": 306,
      "title": "Operacion — todas las conversaciones",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 117 },
      "id": 9,
      "title": "Latencia LLM por operacion (p50/p90/p99)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(llm_request_duration_milliseconds_bucket[$__rate_interval])) by (le, llm_operation))",
          "legendFormat": "p50 — {{llm_operation}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(llm_request_duration_milliseconds_bucket[$__rate_interval])) by (le, llm_operation))",
          "legendFormat": "p90 — {{llm_operation}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(llm_request_duration_milliseconds_bucket[$__rate_interval])) by (le, llm_operation))",
          "legendFormat": "p99 — {{llm_operation}}",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 117 },
      "id": 10,
      "title": "Tokens LLM consumidos (input/output por modelo)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_tokens_total[$__rate_interval])) by (llm_model, llm_token_type)",
          "legendFormat": "{{llm_model}} — {{llm_token_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 125 },
      "id": 11,
      "title": "Conversaciones iniciadas vs completadas",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({exporter=\"OTLP\"} |= `New screening started` [$__interval]))",
          "legendFormat": "Iniciadas",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({exporter=\"OTLP\"} |= `Screening completed` [$__interval]))",
          "legendFormat": "Completadas",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 133 },
      "id": 307,
      "title": "Cumplimiento — consentimiento, escalaciones y evaluaciones",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 134 },
      "id": 12,
      "title": "Escalaciones recientes (salario / solicitud de humano)",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{exporter=\"OTLP\"} |= `Escalation triggered`",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 134 },
      "id": 13,
      "title": "Evaluaciones generadas (recomendacion + score)",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{exporter=\"OTLP\"} |= `Evaluation generated`",
          "refId": "A"
        }
      ]
    }
