# Copia este archivo a .env.local y ajusta los valores:
#   cp .env.example .env.local

NODE_ENV=development
NEXT_PUBLIC_DEV_MODE=true   # habilita el form de usuario/contraseña en /login (test/test)

# DynamoDB — LocalStack de clase9/repos/localstack (docker compose up ahí primero)
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE_PREFIX=entrevista-ai-local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# NextAuth (dev credentials: test / test)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-nextauth-secret-32chars!!

# OpenAI — requerido, el chat-client lo lee directo de env (sin mock)
OPENAI_API_KEY=sk-tu-key-aqui   # exporta el real vía ~/.zshrc, no lo pongas aquí

# Telegram — requerido para el bot, se lee directo de env (sin mock)
TELEGRAM_BOT_TOKEN=             # exporta el real vía ~/.zshrc, no lo pongas aquí
# Long-polling local: alternativa al webhook (que requiere HTTPS público, ver README)
TELEGRAM_POLLING=true

# OpenTelemetry — envía telemetría al Collector de clase11/repos/otel-stack
OTEL_SERVICE_NAME=hr-ia-webapp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
